{
  "name": "clockify-mcp",
  "version": "0.12.0",
  "description": "Local Clockify time tracking for Claude Code and Codex: tools run on this computer, contact Clockify only when used, and keep each user's API key in their OS credential store.",
  "author": {
    "name": "Numaco AG",
    "url": "https://numaco.ch"
  },
  "homepage": "https://github.com/NumacoAG/claude-plugins",
  "repository": "https://github.com/NumacoAG/claude-plugins",
  "license": "MIT",
  "keywords": ["clockify", "time-tracking", "mcp", "productivity"],
  "mcpServers": {
    "clockify": {
      "command": "uv",
      "args": [
        "--directory",
        "${CLAUDE_PLUGIN_ROOT}",
        "run",
        "clockify-mcp"
      ]
    }
  }
}
